{
  "name": "playwrightautomationpractise",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "regression": "npx playwright test",
    "webTests": "npx playwright test --grep @Web",
    "APITests": "npx playwright test --grep @API",
    "chromeTests": "npx playwright test --config playwright.config1.js --project=chrome",
    "EcommerceReport": "npx cucumber-js features/Ecommerce.feature --parallel 2 --retry 1 --exit --format html:cucumber-report.html",
    "ValidationError": "npx cucumber-js --tags @Validation --parallel 2 --retry 1 --exit --format html:cucumber-report.html",
    "CucumberRegression": "npx cucumber-js --tags @Regressionaz login --parallel 2 --retry 1 --exit --format html:cucumber-report.html"
  },
